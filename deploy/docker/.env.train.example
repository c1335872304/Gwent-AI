# Copy to deploy/docker/.env.train before changing local or server training
# mounts. Paths are resolved relative to compose.train.yml. Absolute Linux or
# Windows paths are accepted by the Docker host.

# Python stays on the 3.10 line. The official rolling tag controls its exact
# patch release; pin an immutable image digest for a reproducible server run.
GWENT_TRAIN_PYTHON_BASE_IMAGE=python:3.10-slim-bookworm

# Inputs and outputs. models/v3 is always mounted read-only; training results
# belong in runs/ and artifacts/ until explicit model promotion.
GWENT_TRAIN_CONFIG_DIR=../../configs
GWENT_TRAIN_TASK_DIR=../../training/tasks
GWENT_TRAIN_MODEL_DIR=../../models/v3
GWENT_TRAIN_RUNS_DIR=../../runs
GWENT_TRAIN_ARTIFACTS_DIR=../../artifacts

# Match these on a Linux server to the account that owns the bind-mounted
# output directories. Docker Desktop can retain the default values.
GWENT_TRAIN_UID=1000
GWENT_TRAIN_GID=1000
GWENT_TRAIN_SHM_SIZE=1gb
