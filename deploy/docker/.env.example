# Copy this file to deploy/docker/.env before changing local deployment values.
# Paths are resolved relative to deploy/docker/compose.cpu.yml.  An absolute
# Windows path is also accepted by Docker Desktop, for example C:/Models/gwent.

# Directory containing the final policy.pt.  No server runs/, artifacts/, or
# intermediate checkpoints are mounted into the local product.
GWENT_DOCKER_MODEL_DIR=../../models/v3

# The only host port exposed by the application.  Core, BFF, and Teacher remain
# on the private Compose network.
GWENT_DOCKER_WEB_PORT=8080

# Use human_vs_ai for the product.  manual_test is available for local rule
# debugging and does not require a model.
GWENT_DOCKER_MODE=human_vs_ai

# Keep the inference image CPU-only.  Pin a version here after the first
# validated local build if reproducible image builds are required.
GWENT_DOCKER_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
GWENT_DOCKER_PYTHON_BASE_IMAGE=python:3.10-slim-bookworm
GWENT_DOCKER_TORCH_VERSION=2.6.0+cpu
